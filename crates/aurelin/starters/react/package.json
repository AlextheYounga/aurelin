{
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "build:all": "npm run build && npm run build:ssr",
    "typecheck": "tsc --noEmit",
    "build:ssr": "vite build --ssr resources/js/ssr.tsx --outDir bootstrap/ssr",
    "start:ssr": "node bootstrap/ssr/ssr.js",
    "health:ssr": "curl --fail --silent --show-error http://127.0.0.1:13714/health",
    "stop:ssr": "curl --fail --silent http://127.0.0.1:13714/shutdown || [ $? -eq 52 ]"
  },
  "dependencies": {
    "@inertiajs/react": "^3.11.0",
    "@laravel/passkeys": "^0.4.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@inertiajs/vite": "^3.11.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  }
}
