{
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "build:all": "npm run build && npm run build:ssr",
    "typecheck": "vue-tsc --noEmit",
    "build:ssr": "vite build --ssr resources/js/ssr.ts --outDir bootstrap/ssr",
    "start:ssr": "node bootstrap/ssr/ssr.js",
    "health:ssr": "curl --fail --silent --show-error http://127.0.0.1:13714/health",
    "stop:ssr": "curl --fail --silent http://127.0.0.1:13714/shutdown || [ $? -eq 52 ]"
  },
  "dependencies": {
    "@inertiajs/vue3": "^3.11.0",
    "@laravel/passkeys": "^0.4.1",
    "vue": "^3.5.24"
  },
  "devDependencies": {
    "@inertiajs/vite": "^3.11.0",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vue-tsc": "^3.1.5"
  }
}
